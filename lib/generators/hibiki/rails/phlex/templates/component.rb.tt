# frozen_string_literal: true

# Generated by hibiki:rails:phlex
class Components::<%= class_name %> < Phlex::HTML
  include Hibiki::Reactive
  include Hibiki::Phlex::Rerenderable
  include Hibiki::Rails::Helpers

  state :count, 0
  derived(:doubled) { count * 2 }

  def view_template
    # The root id is the swap key for transmitted fragments; keep page-unique.
    div(id: "<%= component_dom_id %>") do
      p { "count: #{count} · doubled: #{doubled}" }
      # The island's delegation keeps the button working across replacements.
      button(**on(:increment)) { "+1" }
    end
  end

  def increment
    self.count += 1
  end
end
