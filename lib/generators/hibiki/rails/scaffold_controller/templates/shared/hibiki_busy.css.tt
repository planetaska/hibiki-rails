<%#- ESCAPING: all of this is literal CSS. There is no runtime ERB here at all —
     a .css file is never rendered — so a bare <% is generation time and there
     is nothing to double-escape. The one branch is at the bottom. -%>
/* The app's half of the transport contract: the hibiki client stamps
   data-hibiki-busy / aria-busy / data-hibiki-state on the island root and on
   the control that fired, and these rules turn that into something visible.
   Only ever READ those attributes — never write them.

   One file per app: the rules key on the client's attributes and know nothing
   about any model.

   DELIBERATELY UNLAYERED — unlayered declarations beat Tailwind's layered
   utilities, which is what keeps a control spinner hidden until its control
   is busy. Do not wrap this file in a layer. */

@keyframes hbk-slide { from { transform: translateX(-100%) } to { transform: translateX(340%) } }

/* THE ISLAND is busy — only the island root carries data-hibiki-state.
   visibility, not display, so appearing never reflows what's around it. */
.hbk-island-busy { visibility: hidden }
[data-hibiki-state][data-hibiki-busy] .hbk-island-busy { visibility: visible }

/* The bar above the list. Non-blocking: the list underneath is still real,
   scrollable and clickable. */
.hbk-bar {
  height: 3px; overflow: hidden; border-radius: 3px;
  background: color-mix(in srgb, currentColor 14%, transparent);
}
.hbk-bar::after {
  content: ""; display: block; height: 100%; width: 30%;
  background: color-mix(in srgb, currentColor 55%, transparent);
  transform: translateX(-100%);
}
[data-hibiki-state][data-hibiki-busy] .hbk-bar::after {
  animation: hbk-slide 1.1s ease-in-out infinite;
}

/* THIS CONTROL is busy. :not([data-hibiki-state]) excludes the island root,
   so one row's Save spins that row's button and no other. */
.hbk-control-busy { display: none }
[data-hibiki-busy]:not([data-hibiki-state]) .hbk-control-busy { display: inline-block }

/* Buttons and links dim while their own trip is in flight. Text inputs are
   deliberately excluded — dimming a field mid-typing reads as a fault. */
button[data-hibiki-busy], a[data-hibiki-busy] { opacity: .55; cursor: progress }

/* Connection state is not busy-ness: the content is real, just frozen. */
.hbk-offline, .hbk-stalled { display: none }
[data-hibiki-state="offline"] .hbk-offline,
[data-hibiki-state="stalled"] .hbk-stalled { display: inline-block }
<% unless css? -%>

/* --css=none, so the spinner's look lives here. No `display` in .hbk-spinner —
   the rules above own it. */
@keyframes hbk-rotate { to { transform: rotate(360deg) } }
.hbk-spinner {
  box-sizing: border-box; width: .8em; height: .8em;
  border: 2px solid currentColor; border-right-color: transparent;
  border-radius: 50%; vertical-align: -.1em;
}
.hbk-island-busy.hbk-spinner { display: inline-block }
[data-hibiki-busy] .hbk-spinner { animation: hbk-rotate .7s linear infinite }
<% end -%>
