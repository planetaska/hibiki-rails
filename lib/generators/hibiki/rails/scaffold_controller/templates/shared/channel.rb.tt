<%# GENERATION-time ERB only — this template emits plain Ruby.
    Every tag here is <% and nothing needs escaping. -%>
# The <%= controller_file_name %> island.
#
# NOTE: every PUBLIC instance method here is a client-invocable action.
# Anything not meant to be called from the wire lives under private.
class <%= collection_channel_class_name %> < ApplicationCable::Channel
  include Hibiki::Rails::Channel

  # The streamable the model's after_commit pings.
  CHANGED = "<%= changed_streamable %>"

  def build_graph
    # ---- state ---------------------------------------------------------------

    # A version token — writers bump it, dependent queries re-run.
    @db_version = Hibiki::State.new(0)

    # Seeded from the subscribe params (stamped by the index view from the
    # request URL), so the first broadcast repaints the state the server
    # first-painted instead of resetting to defaults. Untrusted like any
    # subscribe param: the same normalizers the controller uses validate
    # against the query's allowlists.
<% if searchable? -%>
    @query = Hibiki::State.new(params[:query].to_s)
<% end -%>
    @filters = Hibiki::State.new(<%= query_class_name %>.filters_from(params))
    @sort = Hibiki::State.new(<%= query_class_name %>.sort_from(params))
    @direction = Hibiki::State.new(<%= query_class_name %>.direction_from(params))

    # The window, as a page number — shared by both pagination modes.
    @page = Hibiki::State.new(<%= query_class_name %>.page_from(params))

    # Which row renders the form instead of its display markup.
    @editing_id = Hibiki::State.new(nil)
    # One form serves every row; #hydrate is the reset path.
    @form = <%= form_class_name %>.new
<% if inline_create? -%>

    # The inline create form. Its own form object, so an open row edit and
    # an open create form never fight over one instance.
    @creating = Hibiki::State.new(false)
    @new_form = <%= form_class_name %>.new
<% end -%>

    # ---- derived -------------------------------------------------------------

    # Reads neither sort nor window, so re-sorting and paging cost no COUNTs.
    @counts = Hibiki::Derived.new do
      @db_version.value
      <%= query_class_name %>.new(<%= "query: @query.value, " if searchable? %>filters: @filters.value).counts
    end

    @page_count = Hibiki::Derived.new { <%= query_class_name %>.page_count(@counts.value[:matched]) }

    # @page can overshoot (destroy the last row of the last page); the clamp
    # self-heals it.
    @window = Hibiki::Derived.new { @page.value.clamp(1, @page_count.value) }

    # Lazy: N invalidations inside one action still mean one query.
    # record_equals, because ActiveRecord's == is id-only and calls an edited
    # row unchanged — the comparator keeps both repaint gates honest.
    @rows = Hibiki::Derived.new(equals: Hibiki::Rails.record_equals) do
      @db_version.value # the tracked dependency
      <%= query_class_name %>.new(<%= "query: @query.value, " if searchable? %>filters: @filters.value,
<%= " " * (query_class_name.length + 11) %>sort: @sort.value, direction: @direction.value,
<%= " " * (query_class_name.length + 11) %>page: @window.value).rows
    end

    # Matching rows not yet shown — read by the infinite-scroll control.
    @remaining = Hibiki::Derived.new { @counts.value[:matched] - @rows.value.size }
<% schema.belongs_tos.each do |column| -%>

    # One collection per belongs_to, only read while a form is open.
    @<%= column.options_local %> = Hibiki::Derived.new do
      @db_version.value
      <%= column.association_class_name %>.order(:<%= column.label_column %>).pluck(:<%= column.label_column %>, :id)
    end
<% end -%>

    # ---- effects -------------------------------------------------------------

    # One render effect for the whole list fragment. Morph, not replace:
    # it keeps focus and caret in an open inline form.
    Hibiki::Effect.new do
      broadcast_morph target: "<%= list_dom_id %>", <%= list_broadcast_source(indent: 22) %>
    end

    # Reactive values: text placeholders matched document-wide.
    transmit_value(:<%= value_name("total") %>) do
      @db_version.value
      <%= class_name %>.count
    end
    transmit_value(:<%= value_name("matched") %>) { @counts.value[:matched] }
    transmit_value(:<%= value_name("range") %>) do
      <%= query_class_name %>.range_label(page: @window.value, shown: @rows.value.size)
    end
    transmit_value(:<%= value_name("direction") %>) { <%= query_class_name %>.direction_label(@direction.value) }
<% if schema.primary_boolean -%>
    # Matching-scoped, not window-scoped.
    transmit_value(:<%= value_name(schema.primary_boolean.name) %>) { @counts.value[:<%= schema.primary_boolean.name %>] }
<% end -%>

    # Mirror the graph into the address bar (replaceState, no history
    # entries). An open form mirrors its fallback URL, so a reload
    # mid-edit lands on the standard page.
    transmit_url do
<% if inline_create? -%>
      if @creating.value
        urls.<%= new_helper(type: :path) %>
      elsif (id = @editing_id.value) && @rows.value.any? { it.id == id }
<% else -%>
      if (id = @editing_id.value) && @rows.value.any? { it.id == id }
<% end -%>
        urls.edit_<%= singular_route_name %>_path(id)
      else
        urls.<%= index_helper(type: :path) %>(**query_url_params)
      end
    end
  end

  # ---- actions: query & window -----------------------------------------------
  # ActionCable hands the payload over only when arity == 1 EXACTLY — always
  # `def foo(data)`, never a default argument. The hash has STRING keys.

<% if searchable? -%>
  def search(data)
    @query.value = data["query"].to_s
    reset_window
  end

<% end -%>
  # One action for both pagination modes; overshoot heals through @window's
  # clamp, but a non-positive page is rejected outright.
  def go_to_page(data)
    return unless <%= query_class_name %>::PAGE_SIZE   # --skip-pagination
    page = data["page"].to_i
    return unless page.positive?

    @page.value = page
  end

  # The view offers, the channel decides: validate against the allowlist.
  def set_filter(data)
    column = data["column"].to_s.to_sym
    return unless <%= query_class_name %>::FILTERABLE.include?(column)

    raw = data[column.to_s].to_s
    filters = @filters.peek.dup
    if raw.empty?
      filters.delete(column)
    else
      filters[column] = <%= class_name %>.type_for_attribute(column).cast(raw)
    end
    @filters.value = filters
    reset_window
  end

  def set_sort(data)
    column = data["sort"].to_s.to_sym
    return unless <%= query_class_name %>::SORTABLE.include?(column)

    @sort.value = column
    reset_window
  end

  def toggle_direction
    @direction.value = (@direction.peek == :asc ? :desc : :asc)
    reset_window
  end

  # ---- actions: records ------------------------------------------------------
<% schema.booleans.each do |column| -%>

  # A SET, not a toggle, so two tabs clicking the same row converge.
  def set_<%= column.name %>(data)
    record = <%= class_name %>.find_by(id: data["id"])
    return unless record

    record.update!(<%= column.name %>: <%= class_name %>.type_for_attribute(:<%= column.name %>).cast(data["<%= column.name %>"]))
    # Kept alongside the after_commit ping: update_all / raw SQL bypass callbacks.
    invalidate
  end
<% end -%>

  def destroy(data)
    record = <%= class_name %>.find_by(id: data["id"])
    return unless record

    record.destroy!
    @editing_id.value = nil if @editing_id.peek == record.id
    invalidate
  end

  # ---- actions: row edit -----------------------------------------------------

  def edit(data)
    record = <%= class_name %>.find_by(id: data["id"])
    return unless record

    @form.hydrate(record)
    @editing_id.value = record.id
  end

  def cancel(_data) = @editing_id.value = nil

  def set_field(data)
    name = data["field"].to_s.to_sym
    return unless <%= form_class_name %>.hibiki_attributes.include?(name)

    @form.public_send(:"#{name}=", data[name.to_s])
  end

  def save(data)
    return unless @editing_id.peek

    assign(@form, data)
    # A false commit mirrors the record's errors onto the form, so the repaint
    # carries the messages.
    return unless @form.commit

    @editing_id.value = nil
    invalidate
  end
<% if inline_create? -%>

  # ---- actions: inline create ------------------------------------------------

  # The New link's action; without JS (or a live link) the same click
  # navigates to the standard new page instead.
  def new_form(_data)
    @new_form.hydrate(<%= class_name %>.new)
    @creating.value = true
  end

  def cancel_new(_data) = @creating.value = false

  def set_new_field(data)
    name = data["field"].to_s.to_sym
    return unless <%= form_class_name %>.hibiki_attributes.include?(name)

    @new_form.public_send(:"#{name}=", data[name.to_s])
  end

  def create(data)
    return unless @creating.peek

    assign(@new_form, data)
    return unless @new_form.commit

    @creating.value = false
    invalidate
  end
<% end -%>

  private

  # PRIVATE deliberately — a public override would become a client-invocable
  # action (see the NOTE at the top).
  def subscribed
    super
    return if subscription_rejected?

    # Delivered on a cable thread — hop to the graph thread before touching a
    # signal.
    stream_from CHANGED do |_message|
      graph_actor&.post { Hibiki.batch { @db_version.value += 1 } }
    end
  end

  def invalidate = @db_version.value += 1

  # Anything that changes the matched set or its order resets the window;
  # single-row edits deliberately don't.
  def reset_window = @page.value = 1

  def list_locals
    rows = @rows.value
    editing_id = @editing_id.value
    # A row outside the window isn't being edited.
    editing_id = nil unless rows.any? { it.id == editing_id }

    {
      <%= controller_file_name %>: rows,
      page: @window.value,
      page_count: @page_count.value,
      remaining: @remaining.value,
      editing_id: editing_id,
      form: (@form if editing_id),
<% if inline_create? -%>
      creating: @creating.value,
      new_form: (@new_form if @creating.value),
<% end -%>
      url_params: query_url_params<%= "," if schema.belongs_tos.any? %>
<% schema.belongs_tos.each_with_index do |column, index| -%>
      <%= column.options_local %>: (<%= inline_create? ? "(editing_id || @creating.value)" : "editing_id" %> ? @<%= column.options_local %>.value : [])<%= "," unless index == schema.belongs_tos.size - 1 %>
<% end -%>
    }
  end

  # The canonical query params for the current graph state — pagination
  # hrefs and transmit_url both read it (signal reads, so callers track).
  def query_url_params
    <%= query_class_name %>.url_params(<%= "query: @query.value, " if searchable? %>filters: @filters.value,
<%= " " * (query_class_name.length + 16) %>sort: @sort.value, direction: @direction.value,
<%= " " * (query_class_name.length + 16) %>page: @window.value)
  end

  def urls = ::Rails.application.routes.url_helpers

  # Assign only declared attributes — the permitted-params analogue.
  def assign(form, data)
    <%= form_class_name %>.hibiki_attributes.each do |name|
      key = name.to_s
      form.public_send(:"#{name}=", data[key]) if data.key?(key)
    end
  end
end
