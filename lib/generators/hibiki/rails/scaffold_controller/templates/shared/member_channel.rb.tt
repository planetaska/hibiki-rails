<%# GENERATION-time ERB only. -%>
# One record, live — the singular sibling of the collection channel.
#
# NOTE: every PUBLIC instance method here is a client-invocable action.
# Anything not meant to be called from the wire lives under private.
class <%= member_channel_class_name %> < ApplicationCable::Channel
  include Hibiki::Rails::Channel

  # Scoped to one record, unlike the collection channel's CHANGED.
  def self.changed(id) = "<%= member_stream_name %>:#{id}:changed"

  def build_graph
    @db_version = Hibiki::State.new(0)

    # The same projection the index uses. find_by, not find: the record can be
    # destroyed while this page is open.
    @row = Hibiki::Derived.new do
      @db_version.value
      record = <%= class_name %>.find_by(id: record_id)
      record && <%= row_class_name %>.from(record)
    end

    Hibiki::Effect.new do
      row = @row.value
      next unless row

      broadcast_morph target: "<%= row_dom_id_prefix %>_#{row.id}", <%= row_broadcast_source(indent: 22) %>
    end
  end

  private

  # record_id is a client-supplied subscribe param — untrusted. Look it up
  # inside a scope this channel chooses, and build the streamable from what the
  # lookup returned, never from the raw param.
  def record_id = @record_id ||= <%= class_name %>.where(id: params[:record_id]).pick(:id)

  # Reject BEFORE super, so an unknown id never builds a graph.
  def subscribed
    return reject unless record_id

    super
    return if subscription_rejected?

    # Delivered on a cable thread — hop to the graph thread before touching a
    # signal.
    stream_from self.class.changed(record_id) do |_message|
      graph_actor&.post { Hibiki.batch { @db_version.value += 1 } }
    end
  end
end
