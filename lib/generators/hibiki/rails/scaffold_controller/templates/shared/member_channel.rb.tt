<%# GENERATION-time ERB only. -%>
# One record, live — the singular sibling of the collection channel: no query,
# no window, no actions, just a row that repaints when THIS record changes.
#
# NOTE: every PUBLIC instance method here is a client-invocable action.
# Everything that is not meant to be called from the wire lives under private.
class <%= member_channel_class_name %> < ApplicationCable::Channel
  include Hibiki::Rails::Channel

  # Scoped, unlike the collection channel's CHANGED. An unscoped ping would
  # repaint every open show page on every write to any record — a query and a
  # render per open tab, for a record the reader is not looking at.
  def self.changed(id) = "<%= member_stream_name %>:#{id}:changed"

  def build_graph
    @db_version = Hibiki::State.new(0)

    # The same projection the index uses, so the row partial renders
    # identically from either channel. find_by, not find: the record can be
    # destroyed while this page is open, and a raise on the graph thread would
    # only freeze the fragment.
    @row = Hibiki::Derived.new do
      @db_version.value
      record = <%= class_name %>.find_by(id: record_id)
      record && <%= row_class_name %>.from(record)
    end

    Hibiki::Effect.new do
      row = @row.value
      next unless row

      broadcast_morph target: "<%= row_dom_id_prefix %>_#{row.id}", partial: "<%= view_dir.delete_prefix('app/views/') %>/<%= row_partial %>",
                      locals: { <%= singular_name %>: row, actions: false }
    end
  end

  private

  # THE TRUST RULE. record_id arrives as a subscribe param, which is
  # client-supplied and untrusted — exactly like a query param. It is used only
  # to look up a record inside a scope THIS channel chooses — the whole table
  # here, current_user's association in an app with owners — and the streamable
  # below is built from the id that lookup RETURNED, never from the raw param.
  # A client naming its own streamable would be reading other people's
  # broadcasts.
  def record_id = @record_id ||= <%= class_name %>.where(id: params[:record_id]).pick(:id)

  # Reject BEFORE super: super builds the graph actor and posts build_graph, so
  # a missing or unknown id should never get that far.
  def subscribed
    return reject unless record_id

    super
    return if subscription_rejected?

    # Delivered on a cable thread — hop to the graph thread before touching a
    # signal. `&.` because the actor can be gone if the client just left.
    stream_from self.class.changed(record_id) do |_message|
      graph_actor&.post { Hibiki.batch { @db_version.value += 1 } }
    end
  end
end
