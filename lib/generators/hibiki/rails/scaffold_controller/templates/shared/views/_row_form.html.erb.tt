<%#- ESCAPING: the peak. <%% emits runtime ERB; a bare <% loops over the schema
     here at generation time; #{...} inside an escaped tag is runtime Ruby and
     passes through untouched. -%>
<%%# locals: (<%= singular_name %>:, form:<%= schema.belongs_tos.map { ", #{it.options_local}:" }.join %>, extras: {}) -%>
<%%# Plain *_tag helpers with UNPREFIXED names, not form_with: the client
    builds the payload with FormData, so the keys must be exactly the
    ReactiveForm's attribute names. Field ids are prefixed per row so nothing
    collides. %>
<%% dom = "<%= row_dom_id_prefix %>_#{<%= singular_name %>.id}" %>
<%%# reset: false — a failed commit must not blank the fields. %>
<%%= tag.form(**on(:save, event: :submit, reset: false)<%= css? ? %(, class: "#{css(:row_form)}") : "" %>) do %>
  <div<%= css_attr(:fieldset) %>>
<% schema.columns.each_with_index do |column, index| -%>
<% if column.type == :boolean -%>
    <div<%= css_attr(:checkbox_wrap) %>>
      <%%# A changed checkbox sends its checked state as a JSON boolean — no
          hidden-field pair needed. %>
      <%%= label_tag "#{dom}_<%= column.name %>"<%= css? ? %(, class: "#{css(:label)}") : "" %> do %>
        <%%= check_box_tag "<%= column.name %>", "1", form.<%= column.name %>,
                          id: "#{dom}_<%= column.name %>",
<% if css? -%>
                          class: "<%= css(:toggle) %>",
<% end -%>
                          **on(:set_field, event: :change, with: { field: "<%= column.name %>" }) %>
        <%= column.human_name %>
      <%% end %>
    </div>
<% else -%>
    <%%= label_tag "#{dom}_<%= column.name %>", "<%= column.human_name %>"<%= css? ? %(, class: "#{css(:label)}") : "" %> %>
<% if column.belongs_to? -%>
    <%%= select_tag <%= wrapped_list(row_select_args(column), indent: 19).lstrip %> %>
<% else -%>
    <%%= <%= column.tag_field_helper %> <%= wrapped_list(row_field_args(column), indent: column.tag_field_helper.length + 9).lstrip %> %>
<% end -%>
    <%%= render "shared/field_error", message: form.error_for(:<%= column.name %>) %>
<% end -%>
<% unless index == schema.columns.size - 1 -%>

<% end -%>
<% end -%>
  </div>

  <div<%= css_attr(:form_actions) %>>
<% if css? -%>
    <%%= tag.button(class: "<%= css(:btn_primary) %>") do %>
<% else -%>
    <%%= tag.button do %>
<% end -%>
      <%%# Spins while THIS form's trip is in flight (hbk-control-busy). %>
      <span<%= hbk_attr("hbk-control-busy", "hbk-spinner", token: :spinner) %> aria-hidden="true"></span>
      Save
    <%% end %>
    <%%# type: "button" — tag.button defaults to submit. %>
    <%%= tag.button("Cancel", type: "button"<%= css? ? %(, class: "#{css(:btn)}") : "" %>,
                   **on(:cancel, with: { id: <%= singular_name %>.id })) %>
    <%%# A badge, not a disabled Save: dirty? only moves after a round trip
        and must not gate the gesture. %>
    <%% if form.dirty? %>
      <span<%= css_attr(:badge_warning) %>>unsaved changes</span>
    <%% end %>
  </div>
<%% end %>
