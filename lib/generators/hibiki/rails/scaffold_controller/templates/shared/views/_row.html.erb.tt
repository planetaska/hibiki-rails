<%#- ESCAPING: <%% emits runtime ERB into the generated view; a bare <% is a
     generation-time loop over the schema. The #{...} inside an escaped tag is
     runtime Ruby and passes through untouched. -%>
<%%# locals: (<%= singular_name %>:, actions: true, editing: false, form: nil<%= schema.belongs_tos.map { ", #{it.options_local}: []" }.join %>, extras: {}) -%>
<%%# `<%= singular_name %>` is a record either way: a frozen read-only
    snapshot from the channel, live from the show page. Rendered by the
    channel through ApplicationController.render, which has no controller
    context — anything this partial branches on arrives as a local with a
    default. %>
<%%# The root id stays stable across display/edit, so idiomorph pairs the
    subtrees instead of rebuilding them (and losing focus). %>
<div id="<%= row_dom_id_prefix %>_<%%= <%= singular_name %>.id %>"<%= css_attr(:card) %>>
  <div<%= css_attr(:card_body) %>>
    <%% if editing %>
    <%%= render "<%= partial_path(row_form_partial) %>", <%= wrapped_list(row_form_render_locals, indent: render_indent(partial_path(row_form_partial))).lstrip %> %>
    <%% else %>
<% schema.columns.each do |column| -%>
    <div>
      <strong><%= column.human_name %>:</strong>
<% if column.type == :boolean -%>
      <%% if actions %>
        <%%# A SET, not a toggle: the client sends the checkbox's checked state,
            so two tabs racing on one row converge. %>
        <%%= check_box_tag <%= wrapped_list(row_toggle_args(column), indent: 26).lstrip %> %>
      <%% else %>
        <%%= <%= singular_name %>.<%= column.name %> ? "Yes" : "No" %>
      <%% end %>
<% else -%>
      <%%= <%= singular_name %>.<%= column.display_reader %> %>
<% end -%>
    </div>

<% end -%>
    <%% if actions %>
    <div<%= css_attr(:card_actions) %>>
      <%%= link_to "Show this <%= human_name.downcase %>", <%= singular_route_name %>_path(<%= singular_name %>.id)<%= css? ? %(, class: "#{css(:btn_outline)}") : "" %> %>
      <%%# fallback: true — while the island's link is live the click opens the
          inline form; otherwise the href navigates to the standard edit page. %>
      <%%= link_to <%= wrapped_list(edit_link_args, indent: 18).lstrip %> %>
      <%%# A real DELETE form (button_to), so destroy degrades natively: live,
          the submit is intercepted and the channel action fires; dead, the
          form posts _method=delete to the standard controller. The client
          freshens the form's authenticity_token before any native submit —
          rows repainted by the channel render without a session, so their
          forms carry no token. confirm: gates both paths while scripts run.
          turbo: false — the degraded submit is a plain full-page POST. %>
      <%%= button_to "Destroy", <%= singular_route_name %>_path(<%= singular_name %>.id), method: :delete,
<% if css? -%>
                    class: "<%= css(:btn_warning) %>",
<% end -%>
                    form: { data: { turbo: false }.merge(
                      on(:destroy, event: :submit, with: { id: <%= singular_name %>.id },
                         confirm: "Are you sure?", fallback: true)[:data]) } %>
    </div>
    <%% end %>
    <%% end %>
  </div>
</div>
