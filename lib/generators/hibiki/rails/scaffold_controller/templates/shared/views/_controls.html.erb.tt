<%#- ESCAPING: <%% emits runtime ERB into the generated view; a bare <% is
     consumed here at generation time. Most of this file is GENERATION time —
     the option lists are built from the schema and baked in. -%>
<%%# locals: (sort: :id, direction: :asc) -%>
<%%# Search / filter / sort: pure signal state. Inside the island, but outside
    the replaced fragment — a list repaint can't clobber what the user is
    typing. %>
<div<%= css_attr(:controls) %>>
<% if searchable? -%>
  <label<%= css_attr(:form_control) %>>
    <span<%= css_attr(:label_text) %>>Search</span>
    <%%# `input` events, debounced by `on` at 250ms. %>
    <%%= search_field_tag <%= wrapped_list(search_field_args, indent: 25).lstrip %> %>
  </label>

<% end -%>
<% schema.booleans.each do |column| -%>
  <label<%= css_attr(:form_control) %>>
    <span<%= css_attr(:label_text) %>><%= column.human_name %></span>
    <%%= select_tag <%= wrapped_list(filter_select_args(column), indent: 19).lstrip %> %>
  </label>

<% end -%>
  <label<%= css_attr(:form_control) %>>
    <span<%= css_attr(:label_text) %>>Sort by</span>
    <%%= select_tag :sort,
                   options_for_select(
                     [<%= sort_option_pairs(indent: 22).lstrip %>], sort.to_s),
                   <%= wrapped_list(sort_select_tail_args, indent: 19).lstrip %> %>
  </label>

  <%%# Never re-rendered, so the label is a reactive value. The visible text
      reports the state; the static aria-label carries the action. %>
  <%%= tag.button(<%= wrapped_list(direction_button_args, indent: 17).lstrip %>) do %>
    <%%= reactive :<%= value_name("direction") %>, <%= query_class_name %>.direction_label(direction) %>
  <%% end %>

  <%%# Reactive-value placeholders — outside the replaced fragment, so a swap
      never resets their text. %>
  <p<%= css_attr(:counts) %>>
    Showing <%%= reactive :<%= value_name("range") %>, "" %>
    of <%%= reactive :<%= value_name("matched") %>, "" %> matching
<% if schema.primary_boolean -%>
    · <%%= reactive :<%= value_name(schema.primary_boolean.name) %>, "" %> <%= schema.primary_boolean.name %>
<% end -%>

    <%%# aria-hidden: the client already puts aria-busy on the island root. %>
    <span<%= hbk_attr("hbk-island-busy", "hbk-spinner", token: :spinner) %> aria-hidden="true"></span>

    <%%# Connection state, not busy-ness. A live region, so it is announced. %>
    <span role="status"<%= css_attr(:warning_text) %>>
      <span class="hbk-offline">offline — reconnecting…</span>
      <span class="hbk-stalled">no response</span>
    </span>
  </p>
</div>
