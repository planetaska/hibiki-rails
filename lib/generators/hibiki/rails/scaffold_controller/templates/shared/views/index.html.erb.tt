<%#- ESCAPING: <%% emits runtime ERB into the generated view. -%>
<%% content_for :title, "<%= human_name.pluralize %>" %>
<%% cid = SecureRandom.uuid %>

<div<%= css_attr(:page) %>>
  <h1<%= css_attr(:heading) %>><%= human_name.pluralize %></h1>

  <div<%= css_attr(:actions_bar) %>>
    <%%= link_to "New <%= human_name.downcase %>", <%= new_helper(type: :path) %><%= css? ? %(, class: "#{css(:btn_primary)}") : "" %> %>
  </div>

  <%%# The island. The data-hibiki-* attributes are a private Ruby<->JS
      contract — always go through the helpers, never write them by hand. %>
  <%%= tag.div(**hibiki_island(<%= collection_channel_class_name %>, cid:)) do %>
    <%%# The client waits for this source to confirm before subscribing. %>
    <%%= turbo_stream_from "<%= collection_stream_name %>", cid %>

    <%%= render "<%= partial_path('controls') %>" %>

    <%%# Non-blocking progress bar, outside the replaced fragment so a swap
        can't destroy it. Styled by app/assets/stylesheets/hibiki_busy.css. %>
    <div<%= hbk_attr("hbk-island-busy", "hbk-bar") %> aria-hidden="true"></div>

    <%%# First paint renders the same partial the channel's render effect
        re-broadcasts — one code path. %>
    <%%= render "<%= partial_path('list') %>", <%= wrapped_list(index_render_locals, indent: render_indent(partial_path("list"))).lstrip %> %>
  <%% end %>
</div>
