<%#- ESCAPING: <%% emits runtime ERB into the generated view; a bare <% is
     consumed here at generation time. -%>
<%%# locals: (<%= list_locals_signature %>) -%>
<%%# The island's re-rendered fragment. Its root id is the broadcast target —
    deliberately not the island root, which carries the stream source. %>
<div id="<%= list_dom_id %>"<%= css_attr(:list) %>>
<% unless infinite? -%>
  <%%# Both page-control copies live inside the replaced fragment on purpose,
      so they re-render with the list; their distinct ids keep idiomorph from
      rebuilding them. %>
  <%% pages = <%= query_class_name %>.page_numbers(page: page, page_count: page_count) %>
  <%%= render "shared/pagination", page: page, page_count: page_count, pages: pages,
             anchor: "#<%= list_dom_id %>", id: "<%= pagination_dom_id %>_top" %>

<% end -%>
  <%% <%= controller_file_name %>.each do |<%= singular_name %>| %>
    <%%= render "<%= partial_path(row_partial) %>", <%= wrapped_list(row_render_locals, indent: render_indent(partial_path(row_partial)), width: 0).lstrip %> %>
  <%% end %>

  <%% if <%= controller_file_name %>.empty? %>
    <p id="<%= empty_dom_id %>"<%= css_attr(:muted) %>>No <%= human_name.downcase.pluralize %> match.</p>
  <%% end %>

<% if infinite? -%>
  <%%# `visible` is a pseudo-event backed by an IntersectionObserver, so this
      button doubles as the infinite-scroll sentinel. The client stamps
      data-hibiki-busy on it while the next page is in flight. %>
  <%% if remaining.positive? %>
    <div id="<%= load_more_dom_id %>"<%= css_attr(:load_more_wrap) %>>
      <%%= tag.button(type: "button",
<% if css? -%>
                     class: "<%= css(:btn_wide) %>",
<% end -%>
                     **on(:go_to_page, event: %i[click visible],
                                       with: { page: page + 1 })) do %>
        Load more<span<%= css_attr(:muted_inline) %>>&nbsp;·&nbsp;<%%= remaining %> remaining</span>
      <%% end %>
    </div>
  <%% end %>
<% else -%>
  <%%= render "shared/pagination", page: page, page_count: page_count, pages: pages,
             anchor: "#<%= list_dom_id %>", id: "<%= pagination_dom_id %>" %>
<% end -%>
</div>
