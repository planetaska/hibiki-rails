<%# GENERATION-time ERB only. NOTE: generated Ruby follows rubocop-rails-omakase
    (spaces inside array literals), which is what a stock Rails app lints with —
    not this gem's own style. -%>
# The index query, in one place — shared by the controller's first paint and
# <%= collection_channel_class_name %>'s live signal state.
#
# Everything here is derived from the schema:
<% if searchable? -%>
#   string / text column -> a LIKE term             (SEARCHABLE)
<% end -%>
#   boolean column       -> a filter, and a count   (FILTERABLE)
#   comparable column    -> a sort option           (SORTABLE)
<% schema.belongs_tos.each do |column| -%>
#   belongs_to           -> includes(:<%= column.association_name %>)
<% end -%>
class <%= query_class_name %>
<% if searchable? -%>
  SEARCHABLE = <%= symbol_array(schema.searchable) %>.freeze
<% end -%>
  FILTERABLE = <%= symbol_array(schema.filterable) %>.freeze
  SORTABLE = <%= symbol_array(schema.sortable) %>.freeze
  DEFAULT_SORT = :id

  # How many rows a page holds; nil means "no window" (--skip-pagination).
  PAGE_SIZE = <%= page_size_literal %>

  # The window, from a page number — the same state in both pagination modes.
  def self.window(relation, page:)
<% if infinite? -%>
    relation.limit(PAGE_SIZE && page * PAGE_SIZE)
<% else -%>
    relation.offset(PAGE_SIZE && (page - 1) * PAGE_SIZE).limit(PAGE_SIZE)
<% end -%>
  end

  # Never 0: an empty list is one (empty) page.
  def self.page_count(matched)
    return 1 unless PAGE_SIZE

    [ (matched.to_f / PAGE_SIZE).ceil, 1 ].max
  end
<% unless infinite? -%>

  # How many numbered links the page control shows before it starts eliding.
  PAGE_WINDOW = 7

  # Which page numbers the control renders; nil is an elision marker ("…").
  def self.page_numbers(page:, page_count:)
    return (1..page_count).to_a if page_count <= PAGE_WINDOW

    middle = ((page - 1)..(page + 1)).select { (2..page_count - 1).cover?(it) }
    [ 1, *middle, page_count ].each_with_object([]) do |n, out|
      out << nil if out.last && n - out.last > 1
      out << n
    end
  end
<% end -%>

  # The sort-direction control's label — reports the current order.
  def self.direction_label(direction)
    direction.to_s == "desc" ? "▼ Descending" : "▲ Ascending"
  end

<% if infinite? -%>
  # A growing limit shows a count, not a range — "Showing 40 of 200 matching".
  def self.range_label(shown:, **) = shown.to_s
<% else -%>
  # "21–40" for a page.
  def self.range_label(page:, shown:)
    return shown.to_s if PAGE_SIZE.nil?
    return "0" if shown.zero?

    first = (page - 1) * PAGE_SIZE + 1
    "#{first}–#{first + shown - 1}"
  end
<% end -%>

  def initialize(query: "", filters: {}, sort: DEFAULT_SORT, direction: :asc,
                 page: 1)
    @term = query.to_s.strip
    @filters = filters
    @sort = SORTABLE.include?(sort&.to_sym) ? sort.to_sym : DEFAULT_SORT
    @direction = direction.to_s == "desc" ? :desc : :asc
    @page = page
  end

  # The visible window: real records, frozen at the boundary. #freeze locks
  # the attributes, readonly! makes save raise, strict_loading makes an
  # unpreloaded association walk raise — stale-record footguns fail loud.
  def rows
    @rows ||= window_scope.strict_loading.map { it.readonly!; it.freeze }
  end

  def page_count = self.class.page_count(counts[:matched])
  def page = @page
  def range_label = self.class.range_label(page: @page, shown: rows.size)

<% if schema.primary_boolean -%>
  # One grouped COUNT covers both numbers; no ordering, no window.
  def counts
    @counts ||= begin
      by_flag = matched_scope.group(:<%= schema.primary_boolean.name %>).count
      { matched: by_flag.values.sum, <%= schema.primary_boolean.name %>: by_flag[true].to_i }
    end
  end
<% else -%>
  def counts = @counts ||= { matched: matched_scope.count }
<% end -%>

  # Matching rows not in the window.
  def remaining = counts[:matched] - rows.size

  private

  def matched_scope = <%= searchable? ? "apply_filters(apply_query(#{class_name}.all))" : "apply_filters(#{class_name}.all)" %>

<% if schema.belongs_tos.any? -%>
  # includes only here: the association label is needed for the window, never
  # for a count.
<% end -%>
  def window_scope = self.class.window(apply_sort(matched_scope<%= belongs_to_includes %>), page: @page)
<% if searchable? -%>

  def apply_query(relation)
    return relation if @term.empty?

    pattern = "%#{<%= class_name %>.sanitize_sql_like(@term)}%"
    relation.where(SEARCHABLE.map { <%= class_name %>.arel_table[it].matches(pattern) }.reduce(:or))
  end
<% end -%>

  def apply_filters(relation)
    @filters.reduce(relation) do |rel, (column, value)|
      FILTERABLE.include?(column.to_sym) ? rel.where(column => value) : rel
    end
  end

  # Allowlisted column plus a stable tiebreaker, so paging never skips rows on
  # ties. No NULLS clause: databases disagree on NULL placement and the syntax
  # is not portable — pin it per adapter if you need to.
  def apply_sort(relation)
    order = { @sort => @direction }
    order[:id] = :asc unless @sort == :id
    relation.order(order)
  end
end
