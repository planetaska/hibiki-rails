<%# GENERATION-time ERB only — this template emits plain Ruby, so every tag
    here is <% and there is nothing to escape. -%>
# The index projection: one plain value per row, so the graph never holds a
# live record. ActiveRecord#== compares class and id only, which makes a
# reloaded record == a stale one — re-assigning a signal from a fresh query
# would be a silent no-op. Data's structural == is what lets the rows derived
# notice a change at all, and what the effect equality gate compares.
#
# Members: every attribute except the timestamps, plus one label per
# belongs_to — the association's first string column — so the row partial
# never walks an association off the graph thread.
#
# The model delegates the same readers, which is what lets the show page keep
# rendering that partial with a live record instead of a projection.
<%= row_class_name %> = Data.define(
<%= wrapped_symbols(schema.row_members) %>
) do
  def self.from(record)
    new(
<% schema.row_members.each_with_index do |member, index| -%>
      <%= member %>: record.<%= member %><%= "," unless index == schema.row_members.size - 1 %>
<% end -%>
    )
  end

  def self.all(scope) = scope.map { |record| from(record) }
end
