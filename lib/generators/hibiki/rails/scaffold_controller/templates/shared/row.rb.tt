<%# GENERATION-time ERB only — this template emits plain Ruby, so every tag
    here is <% and there is nothing to escape. -%>
# The index projection: one plain value per row, so the graph never holds a
# live record. Members: every attribute except the timestamps, plus one label
# per belongs_to. The model delegates the same readers, so the show page can
# render the same partial with a live record.
<%= row_class_name %> = Data.define(
<%= wrapped_symbols(schema.row_members) %>
) do
  def self.from(record)
    new(
<% schema.row_members.each_with_index do |member, index| -%>
      <%= member %>: record.<%= member %><%= "," unless index == schema.row_members.size - 1 %>
<% end -%>
    )
  end

  def self.all(scope) = scope.map { |record| from(record) }
end
