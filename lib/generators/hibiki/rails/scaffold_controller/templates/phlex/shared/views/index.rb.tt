<%#- ESCAPING: none — plain Ruby out, every <% is generation time. -%>
# frozen_string_literal: true

class <%= view_class_name(:index) %> < Views::Base
<%= phlex_includes(:content_for, :link_to, :turbo_stream_from, hibiki: true) %>

<%= initializer_source([["#{singular_table_name}_query", nil]]) %>

  def view_template
    content_for(:title) { "<%= human_name.pluralize %>" }

    div<%= arg_list(*css_args(:page)) %> do
      h1<%= arg_list(*css_args(:heading)) %> { "<%= human_name.pluralize %>" }

      div<%= arg_list(*css_args(:actions_bar)) %> do
        link_to <%= wrapped_list([%("New #{human_name.downcase}"), new_helper(type: :path), *css_args(:btn_primary)], indent: 16).lstrip %>
      end

      island
    end
  end

  private

  # The island. The data-hibiki-* attributes are a private Ruby<->JS contract —
  # always go through the helpers, never write them by hand.
  def island
    cid = SecureRandom.uuid

    div(**hibiki_island(<%= collection_channel_class_name %>, cid:)) do
      # The client waits for this source to confirm before subscribing.
      turbo_stream_from "<%= collection_stream_name %>", cid

<%= render_call(:controls, [], indent: 6) %>

      # Non-blocking progress bar, outside the replaced fragment so a swap
      # can't destroy it. Styled by app/assets/stylesheets/hibiki_busy.css.
      div(<%= hbk_args("hbk-island-busy", "hbk-bar").first %>, aria_hidden: "true")

      # First paint renders the same component the channel's render effect
      # re-broadcasts — one code path.
<%= render_call(:list, index_render_args, indent: 6) %>
    end
  end
end
