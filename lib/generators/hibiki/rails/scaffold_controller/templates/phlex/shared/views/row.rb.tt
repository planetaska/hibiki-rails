<%#- ESCAPING: none needed anywhere in this tree. A Phlex component is plain
     Ruby, so every <% below is generation time and there is no second template
     language to escape into. #{...} inside a quoted string is runtime Ruby and
     passes through untouched. -%>
# frozen_string_literal: true

# One row, in either of its two modes.
#
# `@<%= singular_name %>` is a record either way: a frozen read-only snapshot
# from the channel, live from the show page. Rendered by the channel through
# ApplicationController.render, which has no controller context — everything
# this component branches on is a keyword argument instead.
class <%= view_class_name(:row) %> < Views::Base
<%= phlex_includes(:link_to, (:check_box_tag if schema.booleans.any?), hibiki: true) %>

<%= initializer_source([[singular_name, nil], %w[actions true], %w[editing false], %w[form nil],
                        *schema.belongs_tos.map { [it.options_local.to_s, "[]"] }]) %>

  def view_template
    # The root id stays stable across display/edit, so idiomorph pairs the
    # subtrees instead of rebuilding them (and losing focus).
    div<%= arg_list(%(id: "#{row_dom_id_prefix}_\#{#{record_ref}.id}"), *css_args(:card)) %> do
      div<%= arg_list(*css_args(:card_body)) %> do
        @editing ? edit_form : fields
      end
    end
  end

  private

  def edit_form
<%= render_call(:row_form, row_form_render_args, indent: 4) %>
  end

  def fields
<% schema.columns.each do |column| -%>
    div do
      strong { "<%= column.human_name %>:" }
      # Phlex emits no whitespace between siblings.
      whitespace
<% if column.type == :boolean -%>
      if @actions
        # A SET, not a toggle: the client sends the checkbox's checked state,
        # so two tabs racing on one row converge.
        check_box_tag <%= wrapped_list(row_toggle_args(column), indent: 22).lstrip %>
      else
        plain(<%= record_ref %>.<%= column.name %> ? "Yes" : "No")
      end
<% else -%>
      plain <%= display_source(column) %>
<% end -%>
    end
<% end -%>

    row_actions if @actions
  end

  def row_actions
    div<%= arg_list(*css_args(:card_actions)) %> do
      link_to <%= wrapped_list([%("Show this #{human_name.downcase}"), "#{singular_route_name}_path(#{record_ref}.id)", *css_args(:btn_outline)], indent: 14).lstrip %>
      whitespace
      button<%= arg_list(*row_button_attr_args(:edit, :btn_outline), indent: 13) %> { "Edit" }
      whitespace

      # confirm: is the client-side equivalent of data-turbo-confirm — the
      # action is gated before it is ever performed.
      button<%= arg_list(*row_button_attr_args(:destroy, :btn_warning, confirm: "Are you sure?"), indent: 13) %> { "Destroy" }
    end
  end
end
