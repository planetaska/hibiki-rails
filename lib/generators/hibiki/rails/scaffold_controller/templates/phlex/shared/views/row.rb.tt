<%#- ESCAPING: none needed anywhere in this tree. A Phlex component is plain
     Ruby, so every <% below is generation time and there is no second template
     language to escape into. #{...} inside a quoted string is runtime Ruby and
     passes through untouched. -%>
# frozen_string_literal: true

# One row, in either of its two modes.
#
# `@<%= singular_name %>` is duck-typed: the row projection from the index and from
# the channel's render effect, the ActiveRecord model from the show page. Both
# answer the column readers plus the association labels (the row carries them,
# the model delegates them), so this component has one contract and two
# satisfying types.
#
# It reads NO controller context. A channel renders it through
# ApplicationController.render, whose controller instance never ran #process:
# action_name is nil, params and session are empty, and controller_name is
# "application" — all SILENTLY. Everything it branches on is a keyword
# argument instead, which Ruby enforces at the call site.
class <%= view_class_name(:row) %> < Views::Base
<%= phlex_includes(:link_to, (:check_box_tag if schema.booleans.any?), hibiki: true) %>

<%= initializer_source([[singular_name, nil], %w[actions true], %w[editing false], %w[form nil],
                        *schema.belongs_tos.map { [it.options_local.to_s, "[]"] }]) %>

  def view_template
    # The root id is OUTSIDE the display/edit branch on purpose: a stable id
    # across both modes is what lets idiomorph pair the subtrees under
    # broadcast_morph instead of rebuilding them (and losing focus).
    div<%= arg_list(%(id: "#{row_dom_id_prefix}_\#{#{record_ref}.id}"), *css_args(:card)) %> do
      div<%= arg_list(*css_args(:card_body)) %> do
        @editing ? edit_form : fields
      end
    end
  end

  private

  def edit_form
<%= render_call(:row_form, row_form_render_args, indent: 4) %>
  end

  def fields
<% schema.columns.each do |column| -%>
    div do
      strong { "<%= column.human_name %>:" }
      # Phlex emits NO whitespace between siblings, where ERB's newlines
      # collapsed to one. Without this the label runs into its value.
      whitespace
<% if column.type == :boolean -%>
      if @actions
        # A checkbox, because a changed control reports its CHECKED state
        # rather than its value attribute: the client sends a JSON boolean
        # under the control's name, so the server sets the value it was given
        # instead of flipping whatever it finds — which is also what makes two
        # tabs racing on one row converge.
        #
        # No hidden-field pair: that convention exists for form SUBMIT, and
        # this control talks to the channel directly.
        check_box_tag <%= wrapped_list(row_toggle_args(column), indent: 22).lstrip %>
      else
        plain(<%= record_ref %>.<%= column.name %> ? "Yes" : "No")
      end
<% else -%>
      plain <%= display_source(column) %>
<% end -%>
    end
<% end -%>

    row_actions if @actions
  end

  def row_actions
    div<%= arg_list(*css_args(:card_actions)) %> do
      link_to <%= wrapped_list([%("Show this #{human_name.downcase}"), "#{singular_route_name}_path(#{record_ref}.id)", *css_args(:btn_outline)], indent: 14).lstrip %>
      whitespace
      button<%= arg_list(*row_button_attr_args(:edit, :btn_outline), indent: 13) %> { "Edit" }
      whitespace

      # Per-row pending feedback costs nothing at this site and there is
      # nothing here to see: the client stamps data-hibiki-busy on the control
      # that fired, so the transport stylesheet dims THIS row's button and no
      # other while its trip is in flight. No server state, no markup, no
      # per-row bookkeeping. Destroy is also the site where the feedback
      # matters most — it is the one gesture nobody wants to repeat because the
      # first click looked like it did nothing.
      #
      # The scaffold's button_to carried data-turbo-confirm, which does nothing
      # on a hibiki-driven button — it is not a Turbo-driven form. confirm: is
      # the equivalent, gated client-side before the action is ever performed.
      button<%= arg_list(*row_button_attr_args(:destroy, :btn_warning, confirm: "Are you sure?"), indent: 13) %> { "Destroy" }
    end
  end
end
