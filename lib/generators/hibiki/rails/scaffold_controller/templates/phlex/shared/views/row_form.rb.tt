<%#- ESCAPING: none. Plain Ruby out, so every <% here is generation time. The
     ERB twin of this file carries the densest escaping in the set and this one
     carries none, which is the port's one real simplification. -%>
# frozen_string_literal: true

# The inline edit form for one row, talking to the channel rather than to a
# controller.
#
# Plain *_tag helpers with UNPREFIXED names, not form_with: the client builds
# the payload with FormData, so the keys must be exactly the ReactiveForm's
# attribute names.
class <%= view_class_name(:row_form) %> < Views::Base
<%= phlex_includes(:label_tag, *row_field_helper_modules,
                   *(%i[select_tag options_for_select] if schema.belongs_tos.any?), hibiki: true) %>

<%= initializer_source([[singular_name, nil], ["form", nil],
                        *schema.belongs_tos.map { [it.options_local.to_s, nil] }]) %>

  def view_template
    # reset: false — a failed commit must not blank the fields.
    form<%= arg_list("**on(:save, event: :submit, reset: false)", *css_args(:row_form)) %> do
      div<%= arg_list(*css_args(:fieldset)) %> do
<% schema.columns.each do |column| -%>
        <%= column.name %>_field
<% end -%>
      end

      form_actions
    end
  end

  private

  # Field ids are prefixed per row so nothing collides.
  def dom = "<%= row_dom_id_prefix %>_#{@<%= singular_name %>.id}"

<% schema.columns.each do |column| -%>
  def <%= column.name %>_field
<% if column.type == :boolean -%>
    # A changed checkbox sends its checked state as a JSON boolean — no
    # hidden-field pair needed.
    div<%= arg_list(*css_args(:checkbox_wrap)) %> do
      label_tag<%= arg_list(%("\#{dom}_#{column.name}"), *css_args(:label)) %> do
        check_box_tag <%= wrapped_list([%("#{column.name}"), %("1"), "#{form_ref}.#{column.name}", %(id: "\#{dom}_#{column.name}"), *css_args(:toggle), %(**on(:set_field, event: :change, with: { field: "#{column.name}" }))], indent: 22).lstrip %>
        whitespace
        plain "<%= column.human_name %>"
      end
    end
<% else -%>
    label_tag <%= wrapped_list([%("\#{dom}_#{column.name}"), %("#{column.human_name}"), *css_args(:label)], indent: 14).lstrip %>
<% if column.belongs_to? -%>
    # options_for_select outputs directly, so the options are a block here —
    # phlex-rails' own prescription.
    select_tag<%= arg_list(*row_select_head_args(column), indent: 15) %> do
      <%= row_select_options_source(column) %>
    end
<% else -%>
    <%= column.tag_field_helper %> <%= wrapped_list(row_field_args(column), indent: column.tag_field_helper.length + 5).lstrip %>
<% end -%>
<%= render_call(:field_error, [%(message: #{form_ref}.error_for(:#{column.name}))], indent: 4) %>
<% end -%>
  end

<% end -%>
  def form_actions
    div<%= arg_list(*css_args(:form_actions)) %> do
      button<%= arg_list(*css_args(:btn_primary)) %> do
        # Spins while THIS form's trip is in flight (hbk-control-busy).
        span(<%= hbk_args("hbk-control-busy", "hbk-spinner", token: :spinner).first %>, aria_hidden: "true")
        plain "Save"
      end

      # type: "button" — Phlex's button defaults to submit.
      button<%= arg_list(%(type: "button"), *css_args(:btn), %(**on(:cancel, with: { id: #{record_ref}.id }))) %> { "Cancel" }

      # A badge, not a disabled Save: dirty? only moves after a round trip and
      # must not gate the gesture.
      span<%= arg_list(*css_args(:badge_warning)) %> { "unsaved changes" } if <%= form_ref %>.dirty?
    end
  end
end
