<%#- ESCAPING: none — plain Ruby out, every <% is generation time. -%>
# frozen_string_literal: true

# The island's re-rendered fragment. Its root id is the broadcast target —
# deliberately not the island root, which carries the stream source.
#
# The channel builds this with `.new(**list_locals)`, so these keywords are
# the broadcast's contract.
class <%= view_class_name(:list) %> < Views::Base
<% if infinite? -%>
<%= phlex_includes(hibiki: true) %>

<% end -%>
<%= initializer_source(list_locals) %>

  def view_template
    div<%= arg_list(%(id: "#{list_dom_id}"), *css_args(:list)) %> do
<% if inline_create? -%>
      # The inline create form — only the channel ever renders it (the New
      # link's action sets creating), so the first paint never carries it.
      create_form if @creating

<% end -%>
<% unless infinite? -%>
      # Both page-control copies live inside the replaced fragment on purpose,
      # so they re-render with the list; their distinct ids keep idiomorph
      # from rebuilding them.
      pagination("<%= pagination_dom_id %>_top")

<% end -%>
      @<%= controller_file_name %>.each do |<%= singular_name %>|
<%= render_call(:row, row_render_args(singular_name), indent: 8) %>
      end

      if @<%= controller_file_name %>.empty?
        p<%= arg_list(%(id: "#{empty_dom_id}"), *css_args(:muted)) %> { "No <%= human_name.downcase.pluralize %> match." }
      end

<% if infinite? -%>
      load_more if @remaining.positive?
<% else -%>
      pagination("<%= pagination_dom_id %>")
<% end -%>
    end
  end

  private
<% if inline_create? -%>

  def create_form
<% if motion? -%>
    # data-motion: the client holds the card while it slides shut; the slide
    # itself is hbk-slide in hibiki_motion.css.
    div<%= arg_list(%(id: "#{row_dom_id_prefix}_new"), "data: { motion: true }", *hbk_args("hbk-slide", token: :card)) %> do
      div<%= arg_list(*hbk_args("hbk-slide-body", token: :card_body)) %> do
<% else -%>
    div<%= arg_list(%(id: "#{row_dom_id_prefix}_new"), *css_args(:card)) %> do
      div<%= arg_list(*css_args(:card_body)) %> do
<% end -%>
<%= render_call(:row_form, create_form_render_args, indent: 8) %>
      end
    end
  end
<% end -%>
<% unless infinite? -%>

  def pagination(id)
    pages = <%= query_class_name %>.page_numbers(page: @page, page_count: @page_count)
<%= render_call(:pagination, ["page: @page", "page_count: @page_count", "pages: pages", %(anchor: "##{list_dom_id}"), "id: id", "url: page_url"], indent: 4, shared: true) %>
  end
<% end -%>

  # Real hrefs for the <%= infinite? ? "Load-more link" : "page links" %>, carrying the current query
  # state — the channel re-renders them with url_params fresh, so the
  # fallback URLs stay truthful as the live state moves.
  def page_url
    ->(n) do
      query = @url_params.except(:page)
      query[:page] = n unless n == 1
      <%= index_helper(type: :path) %>(**query)
    end
  end
<% if infinite? -%>

  # `visible` is a pseudo-event backed by an IntersectionObserver: the wrapper
  # is the scroll sentinel, the link inside it is the click path and its href
  # the fallback. A sentinel must never fall back — scrolling into view on a
  # dead socket would navigate.
  def load_more
    div<%= arg_list(%(id: "#{load_more_dom_id}"), *css_args(:load_more_wrap), "**on(:go_to_page, event: :visible, with: { page: @page + 1 })", indent: 8) %> do
      # The STRING "false", not the boolean — Phlex omits false-valued attributes.
      a<%= arg_list("href: load_more_href", *css_args(:btn_wide), "data: { turbo: \"false\" }.merge(on(:go_to_page, with: { page: @page + 1 },\n#{' ' * 42}fallback: true)[:data])", indent: 8) %> do
        plain "Load more"
        span<%= arg_list(*css_args(:muted_inline)) %> { " · #{@remaining} remaining" }
      end
    end
  end

  def load_more_href = "#{page_url.(@page + 1)}#<%= row_dom_id_prefix %>_#{@<%= controller_file_name %>.last.id}"
<% end -%>
end
