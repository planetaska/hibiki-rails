<%#- ESCAPING: none — plain Ruby out, every <% is generation time. -%>
# frozen_string_literal: true

# The island's re-rendered fragment. Its root id is the broadcast target —
# deliberately not the island root, which carries the stream source.
#
# The channel builds this with `.new(**list_locals)`, so these keywords are
# the broadcast's contract.
class <%= view_class_name(:list) %> < Views::Base
<% if infinite? -%>
<%= phlex_includes(hibiki: true) %>

<% end -%>
<%= initializer_source(list_locals) %>

  def view_template
    div<%= arg_list(%(id: "#{list_dom_id}"), *css_args(:list)) %> do
<% unless infinite? -%>
      # Both page-control copies live inside the replaced fragment on purpose,
      # so they re-render with the list; their distinct ids keep idiomorph
      # from rebuilding them.
      pagination("<%= pagination_dom_id %>_top")

<% end -%>
      @<%= controller_file_name %>.each do |<%= singular_name %>|
<%= render_call(:row, row_render_args(singular_name), indent: 8) %>
      end

      if @<%= controller_file_name %>.empty?
        p<%= arg_list(%(id: "#{empty_dom_id}"), *css_args(:muted)) %> { "No <%= human_name.downcase.pluralize %> match." }
      end

<% if infinite? -%>
      load_more if @remaining.positive?
<% else -%>
      pagination("<%= pagination_dom_id %>")
<% end -%>
    end
  end
<% unless infinite? -%>

  private

  def pagination(id)
    pages = <%= query_class_name %>.page_numbers(page: @page, page_count: @page_count)
<%= render_call(:pagination, ["page: @page", "page_count: @page_count", "pages: pages", %(anchor: "##{list_dom_id}"), "id: id"], indent: 4, shared: true) %>
  end
<% end -%>
<% if infinite? -%>

  private

  # `visible` is a pseudo-event backed by an IntersectionObserver, so this
  # button doubles as the infinite-scroll sentinel. The client stamps
  # data-hibiki-busy on it while the next page is in flight.
  def load_more
    div<%= arg_list(%(id: "#{load_more_dom_id}"), *css_args(:load_more_wrap)) %> do
      button<%= arg_list(%(type: "button"), *css_args(:btn_wide), "**on(:go_to_page, event: %i[click visible], with: { page: @page + 1 })", indent: 13) %> do
        plain "Load more"
        span<%= arg_list(*css_args(:muted_inline)) %> { " · #{@remaining} remaining" }
      end
    end
  end
<% end -%>
end
