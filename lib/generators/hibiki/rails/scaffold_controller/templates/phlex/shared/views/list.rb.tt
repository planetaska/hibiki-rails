<%#- ESCAPING: none — plain Ruby out, every <% is generation time. -%>
# frozen_string_literal: true

# The island's re-rendered fragment, rendered by BOTH the controller's first
# paint and the channel's render effect — one code path, so the two can't
# drift. Its root id is the broadcast target: page-unique, stable, and
# deliberately NOT the island root, which carries the stream source; replacing
# that would tear down the very subscription that delivers the replacement.
#
# The channel builds this with `.new(**list_locals)`, so these keywords ARE the
# broadcast's contract. Ruby enforces them, which is the upgrade over the
# strict-locals header the ERB twin carries: a mismatch raises at the call site
# naming the argument, rather than inside the template or not at all.
class <%= view_class_name(:list) %> < Views::Base
<% if infinite? -%>
<%= phlex_includes(hibiki: true) %>

<% end -%>
<%= initializer_source(list_locals) %>

  def view_template
    div<%= arg_list(%(id: "#{list_dom_id}"), *css_args(:list)) %> do
      @<%= controller_file_name %>.each do |<%= singular_name %>|
<%= render_call(:row, row_render_args(singular_name), indent: 8) %>
      end

      if @<%= controller_file_name %>.empty?
        p<%= arg_list(%(id: "#{empty_dom_id}"), *css_args(:muted)) %> { "No <%= human_name.downcase.pluralize %> match." }
      end

<% if infinite? -%>
      load_more if @remaining.positive?
<% else -%>
      # The page control lives INSIDE the replaced fragment on purpose. It
      # renders from server numbers, so a list with nothing more to show simply
      # stops rendering it; placed outside it would never be re-rendered and
      # could only ever change its TEXT (reactive values are textContent-only),
      # leaving a control pointing at pages that no longer exist.
      #
      # Every child of this container carries a stable id for the same reason
      # the rows do: idiomorph pairs subtrees by id, and an id-less trailing
      # node can be matched positionally against the last row and rebuilt
      # instead of kept.
<%= render_call(:pagination, ["page: @page", "page_count: @page_count"], indent: 6) %>
<% end -%>
    end
  end
<% if infinite? -%>

  private

  # TWO events, one element: `visible` is a pseudo-event backed by an
  # IntersectionObserver, so this same button is also the infinite-scroll
  # sentinel — scrolling it into view pages the list, clicking it still works,
  # and there is nothing extra to render or wire up. The observer re-scans
  # after each swap, so the fresh element's initial callback keeps paging when
  # a page didn't fill the viewport.
  #
  # It sends the page AFTER the one it was rendered under, and needs no
  # generation token: a page number is idempotent, so an observer firing again
  # before the swap lands writes the same value and State#value= returns early.
  #
  # It is also its own loading indicator, with nothing added: the client stamps
  # data-hibiki-busy on the control that fired, so this button dims while the
  # next page is on its way. The bar above the list is the wrong answer here —
  # when this fires you are at the BOTTOM of the page and would never see it.
  def load_more
    div<%= arg_list(%(id: "#{load_more_dom_id}"), *css_args(:load_more_wrap)) %> do
      button<%= arg_list(%(type: "button"), *css_args(:btn_wide), "**on(:go_to_page, event: %i[click visible], with: { page: @page + 1 })", indent: 13) %> do
        plain "Load more"
        span<%= arg_list(*css_args(:muted_inline)) %> { " · #{@remaining} remaining" }
      end
    end
  end
<% end -%>
end
