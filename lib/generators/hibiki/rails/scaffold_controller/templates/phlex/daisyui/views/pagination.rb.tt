<%#- ESCAPING: none — plain Ruby out, every <% is generation time. Emitted ONCE
     per app into app/views/shared/, so nothing here may name the resource:
     everything resource-shaped arrives as a keyword from the list component.
     The `--css=` marker in the class comment is how a later scaffold run
     detects a variant mismatch — keep it. -%>
# frozen_string_literal: true

# Shared page control (--css=<%= css_variant %>), rendered above and below
# every scaffolded list. `url` is an optional ->(page) { path } builder:
# when given, links carry real hrefs (plus the fragment) and fallback — a
# dead island degrades to native navigation. Without it the links are plain
# anchors to the list, as before. data-turbo="false" keeps Turbo Drive out.
class Views::Shared::Pagination < Views::Base
<%= phlex_includes(:link_to, hibiki: true) %>

<%= initializer_source([%w[page 1], %w[page_count 1], %w[pages []], ["anchor"], ["id"],
                        %w[url nil]]) %>

  def view_template
    # The wrapper always renders (so idiomorph has a node to pair with) and
    # stays bare — layout classes here would leave dead space when empty.
    div(id: @id) do
      nav<%= arg_list(*css_args(:pagination_nav), %(aria_label: "Pagination")) %> { items } if @page_count > 1
    end
  end

  private

  def items
    # Prev/next go inert at the ends rather than disappearing, so the control
    # keeps its width across a page change.
    @page == 1 ? inert("«") : step("«", @page - 1, rel: "prev", label: "Previous page")
    whitespace

    @pages.each do |n|
      if n.nil?
        span(class: "join-item btn btn-disabled", aria_hidden: "true") { "…" }
      elsif n == @page
        span(class: "join-item btn btn-active", aria_current: "page") { n.to_s }
      else
        step(n.to_s, n, label: "Page #{n}")
      end

      # Phlex emits nothing between siblings.
      whitespace
    end

    @page == @page_count ? inert("»") : step("»", @page + 1, rel: "next", label: "Next page")
  end

  def inert(glyph)
    span(class: "join-item btn btn-disabled", aria_disabled: "true") { glyph }
  end

  # The STRING "false", not the boolean — Phlex omits false-valued attributes.
  # And merge, don't splat: the anchor needs its own data attribute too.
  def step(text, n, label:, rel: nil)
    link_to text, href(n), class: "join-item btn", rel:, "aria-label": label,
            data: { turbo: "false" }.merge(on(:go_to_page, with: { page: n },
                                              fallback: @url ? true : nil)[:data])
  end

  # A real href when a url builder was given; a bare anchor otherwise.
  def href(n) = @url ? "#{@url.(n)}#{@anchor}" : @anchor
end
