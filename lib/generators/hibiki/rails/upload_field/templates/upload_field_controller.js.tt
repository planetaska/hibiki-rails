// Direct-uploads each chosen file the moment it's picked, then hands ONLY the
// signed blob id to the island's graph, via the action and dom the view
// stamped on the input — one controller serves every upload field. A falsy
// performOn return means the island is offline and nothing was queued, so
// the input is reset to show nothing was taken.
import { Controller } from "@hotwired/stimulus"
import { DirectUpload } from "@rails/activestorage"
import { performOn } from "hibiki-rails"

export default class extends Controller {
  static values = { url: String, action: String, dom: String }

  // One file after another, so a gallery's pending list keeps the pick order.
  async upload() {
    const files = Array.from(this.element.files)
    if (!files.length) return

    for (const file of files) {
      const blob = await this.directUpload(file)
      const accepted = blob && performOn(this.element, this.actionValue, {
        dom: this.domValue, signed_id: blob.signed_id, filename: file.name
      })
      if (!accepted) {
        this.element.value = ""
        return
      }
    }
    // A gallery input is cleared once its pick is queued, so the next pick
    // appends; a single-file input keeps showing its choice.
    if (this.element.multiple) this.element.value = ""
  }

  directUpload(file) {
    return new Promise(resolve => {
      new DirectUpload(file, this.urlValue).create((error, blob) => {
        if (error) console.error("upload failed:", error)
        resolve(error ? null : blob)
      })
    })
  }
}
