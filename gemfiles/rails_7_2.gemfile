# frozen_string_literal: true

# CI-matrix Gemfile: Rails 7.2 (see .github/workflows/ci.yml).
source "https://rubygems.org"

gemspec path: ".."

gem "actioncable", "~> 7.2.0"
gem "railties", "~> 7.2.0"

group :development do
  gem "activerecord", "~> 7.2.0"
  gem "rake", "~> 13.0"
  gem "rspec", "~> 3.0"
  gem "rspec-rails", "~> 8.0"
  gem "rubocop", "~> 1.21"
  gem "sqlite3"
end
