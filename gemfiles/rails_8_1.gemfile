# frozen_string_literal: true

# CI-matrix Gemfile: Rails 8.1 (see .github/workflows/ci.yml).
#
# Pinned deliberately even though the root Gemfile currently resolves 8.1
# too: "latest" drifts, and this is the version the CRUD reference app runs.
source "https://rubygems.org"

gemspec path: ".."

gem "actioncable", "~> 8.1.0"
gem "railties", "~> 8.1.0"

group :development do
  gem "activerecord", "~> 8.1.0"
  gem "rake", "~> 13.0"
  gem "rspec", "~> 3.0"
  gem "rspec-rails", "~> 8.0"
  # Same pin as the root Gemfile — this leg has no committed lockfile, so a
  # loose range would float to whatever RuboCop is newest on CI.
  gem "rubocop", "~> 1.90.0"
  gem "sqlite3"
end
